{
  "name": "cad-version-manager",
  "version": "1.0.0",
  "description": "CAD 图纸版本管理系统",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"cd backend && uvicorn app.main:app --reload\" \"cd frontend && npm run dev\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && build.bat",
    "build": "npm run build:frontend && npm run build:backend",
    "dist": "npm run build:frontend && electron-builder",
    "dist:win": "npm run build:frontend && electron-builder --win"
  },
  "build": {
    "appId": "com.cad.version-manager",
    "productName": "CAD版本管理器",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/cad-backend.exe",
        "to": "backend/cad-backend.exe"
      },
      {
        "from": "backend/uploads",
        "to": "backend/uploads"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CAD版本管理器",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "concurrently": "^8.0.0"
  }
}
